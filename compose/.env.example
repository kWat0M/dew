# TODO: このファイルを（compose/ の中に）.env としてコピーして、値を自分の環境に合わせる
# --- 本番・開発の共通 ---
# アプリを公開するホスト側のポート（compose.yaml）
APP_PORT=8080

# --- ここから下は開発用（compose.dev.yaml）。本番の PC では不要 ---
# [1] 基本設定: プロジェクトのホームからの相対パス（コンテナ内では /home/dev/<この値> に置く）
# TODO: ホームからの相対パスに変える
PROJECT_PATH=projects/<プロジェクト名>

# [2][5] dotfiles リポジトリの場所（ssh と Claude Code の設定を読み、dev-tools をビルドする）
DOTFILES=/path/to/dotfiles

# [3] GUI ウィンドウ: dew を公開するホスト側のポート（コンテナごとに別の番号にする）
# TODO: この PC の他のコンテナと重ならない番号にする
DEW_PORT=18765
# [3] GUI ウィンドウ: Windows から見たこの PC の名前か IP（dew が表示する URL に使う）
# TODO: WSL なら localhost、サーバーなら IP アドレス（Windows で名前を解決できないことが多いため）
DEW_PUBLIC_HOST=localhost

# [5] Claude Code: この PC の名前（uname -n の値）。会話履歴の使用中の印に使う
# TODO: この PC の uname -n の値に変える
SYNC_HOST=<uname -n の値>

# [1] 基本設定: ホストの UID/GID。dev.sh が起動するたびに id -u / id -g の値で書き換える（手で書かなくてよい）
# HOST_UID=
# HOST_GID=
# [4] dev-tools: 取り込むイメージの名前。未設定なら dev.sh が既定の名前（dev-tools-<ユーザー名>:latest）を書き込む。
# GHCR などから取り込むときは、ここに書く
# DEV_TOOLS_IMAGE=
# 開発で重ねる compose ファイル。dev.sh が書き込む（手で書かなくてよい）
# COMPOSE_FILE=compose.yaml:compose.dev.yaml
